{
  "info": {
    "name": "Order & Transaction Module API",
    "description": "Complete API collection for Order module testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Verify server is running"
      }
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cartItems\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2,\n      \"price\": 50000\n    },\n    {\n      \"productId\": 2,\n      \"quantity\": 1,\n      \"price\": 75000\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/orders",
          "host": ["{{base_url}}"],
          "path": ["orders"]
        },
        "description": "Create a new order from cart items"
      }
    },
    {
      "name": "Get All Orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/orders?page=1&limit=10",
          "host": ["{{base_url}}"],
          "path": ["orders"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        },
        "description": "Get user's orders with pagination"
      }
    },
    {
      "name": "Get Orders by Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/orders?status=PAID&page=1&limit=10",
          "host": ["{{base_url}}"],
          "path": ["orders"],
          "query": [
            {
              "key": "status",
              "value": "PAID"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        },
        "description": "Get orders filtered by status (PENDING_PAYMENT, PAID, CANCELLED)"
      }
    },
    {
      "name": "Get Order Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/orders/1",
          "host": ["{{base_url}}"],
          "path": ["orders", "1"]
        },
        "description": "Get details of a specific order"
      }
    },
    {
      "name": "Get Order History",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/orders/history?page=1&limit=10",
          "host": ["{{base_url}}"],
          "path": ["orders", "history"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        },
        "description": "Get order history with pagination (alias for GET /orders)"
      }
    },
    {
      "name": "Cancel Order",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/orders/1/cancel",
          "host": ["{{base_url}}"],
          "path": ["orders", "1", "cancel"]
        },
        "description": "Cancel a pending order (PENDING_PAYMENT status only)"
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "YOUR_JWT_TOKEN_HERE",
      "type": "string",
      "description": "Replace with your actual JWT token"
    }
  ]
}
